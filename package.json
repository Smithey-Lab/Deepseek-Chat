{
  "name": "deepseek-chat-desktop",
  "version": "0.3.1",
  "description": "A Windows DeepSeek chat and GitHub coding workspace",
  "private": true,
  "main": "src/main.cjs",
  "author": "Smithey Lab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Smithey-Lab/Deepseek-Chat.git"
  },
  "scripts": {
    "start": "electron .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test test/*.test.cjs",
    "check": "npm run lint && npm run format:check && npm test",
    "dist": "electron-builder --win nsis --x64 --publish never && node scripts/verify-installer.cjs",
    "release": "electron-builder --win nsis --x64 --publish always",
    "repo:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-repo.ps1",
    "release:patch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1",
    "test:desktop": "node scripts/smoke.cjs && node scripts/agent-smoke.cjs"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.6.2"
  },
  "build": {
    "appId": "com.smitheylab.deepseekchat",
    "productName": "DeepSeek Workspace",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Smithey-Lab",
        "repo": "Deepseek-Chat",
        "releaseType": "release"
      }
    ],
    "artifactName": "DeepSeek-Workspace-Setup-${version}.${ext}"
  }
}
